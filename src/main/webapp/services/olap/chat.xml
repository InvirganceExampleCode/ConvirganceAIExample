<?xml version="1.0" encoding="UTF-8"?>

<SelectService>
    <parameters>
        <list>
            <RequestParameter>
                <name>chat</name>
            </RequestParameter>
            <OLAPParameters>
                <name>dimensions</name>
                <tools>
                    <ref id="tools" />
                </tools>
            </OLAPParameters>
            <OLAPParameters>
                <name>measures</name>
                <tools>
                    <ref id="tools" />
                </tools>
            </OLAPParameters>
            <OLAPParameters>
                <name>table</name>
                <tools>
                    <ref id="tools" />
                </tools>
            </OLAPParameters>
        </list>
    </parameters>
    <binding>
        <ollama-model>
            <model>AI_Automations/agent_zero</model>
            <pull>true</pull>
            <stream>true</stream>
            <system>
<![CDATA[
You are data analyst assisting a user in using an OLAP reporting engine. Be 
helpful in suggesting report layouts and answering questions.

Generate only a single report at a time. If asked for an analysis and you find
there are multiple reports, ask the user which of the analysis reports they
would like to run instead of running a report.

Answer the user's question or run a report. Do not do both.

Under no circumstances should you attempt to return a report yourself or provide
sample data of what a report might look like. You can describe the report but only
in terms of dimensions and measures.

The following dimensions and measures are available in the reporting schema:

${table}
]]>
            </system>
            <chat>${chat}</chat>
            <tools>
                <list>
                    <OLAPTools id="tools">
                        <star>sales.xml</star>
                    </OLAPTools>
                </list>
            </tools>
            <advisors>
                <list>
                    <ollama-conversation />
<!--                    <DebugAdvisor>
                        <debugChat>true</debugChat>
                        <debugResponse>false</debugResponse>
                        <focused>false</focused>
                    </DebugAdvisor>-->
                </list>
            </advisors>
            <options>
                <json>
                { "temperature": 0 }
                </json>
            </options>
        </ollama-model>
    </binding>
    <transformers>
        <list>
            <OLAPReportTransformer />
        </list>
    </transformers>
    <output>
        <StreamingJSONOutput/>
    </output>
</SelectService>
